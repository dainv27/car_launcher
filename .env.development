# Development environment configuration
#
# Copy this file to `.env` and adjust values for your local setup, or pass
# `--dart-define` flags directly when running `flutter run` / `flutter build`.
#
# This file is NOT loaded at runtime by the app. It is a reference for
# developers and a convenience script source (e.g. `source .env.development`
# before building). All values must also be supplied via `--dart-define` at
# compile time because the app reads them through `String.fromEnvironment`.

# ---- Identity Provider (Keycloak) ----
# Dev realm on the 202corp IDP.
AUTH_DISCOVERY_URL=https://dev-idp.202corp.com/realms/card_management/.well-known/openid-configuration
AUTH_TOKEN_URL=https://dev-idp.202corp.com/realms/card_management/protocol/openid-connect/token
AUTHORIZATION_ENDPOINT=https://dev-idp.202corp.com/realms/card_management/protocol/openid-connect/auth
LOGOUT_ENDPOINT=https://dev-idp.202corp.com/realms/card_management/protocol/openid-connect/logout
AUTH_CLIENT_ID=car_launcher
AUTH_CLIENT_SECRET=dMx5nYG5LGQy1ovx4VHgMbTfkmjS13bT
AUTH_REDIRECT_URL=carlauncher://oauth/callback
AUTH_LOOPBACK_REDIRECT_URL=http://localhost:47321/oauth/callback

# ---- Vehicle / Tracking Service ----
# Dev vehicle service endpoint used by VehicleTrackingSyncClient.
API_GATEWAY_BASE_URL=https://dev-car-apis.202corp.com/vehicle-service/client-api/v1

# ---- General ----
APP_NAME=Car Launcher
APP_ENV=development
LOG_LEVEL=debug
ENABLE_DEBUG_BANNER=false
