# Production environment configuration
#
# This file is a reference for release builds. Values are compiled into the
# app via `--dart-define` flags (see `flutter build apk --release` below).
#
# IMPORTANT: production secrets (AUTH_CLIENT_SECRET, etc.) must come from a
# secret store / CI pipeline — do not commit real production secrets here.

# ---- Identity Provider (Keycloak) ----
# Production realm / endpoints — replace with real production values.
AUTH_DISCOVERY_URL=https://idp.202corp.com/realms/card_management/.well-known/openid-configuration
AUTH_TOKEN_URL=https://idp.202corp.com/realms/card_management/protocol/openid-connect/token
AUTHORIZATION_ENDPOINT=https://idp.202corp.com/realms/card_management/protocol/openid-connect/auth
LOGOUT_ENDPOINT=https://idp.202corp.com/realms/card_management/protocol/openid-connect/logout
AUTH_CLIENT_ID=car_launcher
AUTH_CLIENT_SECRET=vTCc0KXuiwo9wkbhgMikmGV4U1Miz6Td
AUTH_REDIRECT_URL=carlauncher://oauth/callback
AUTH_LOOPBACK_REDIRECT_URL=http://localhost:47321/oauth/callback

# ---- Vehicle / Tracking Service ----
# Production vehicle service endpoint.
API_GATEWAY_BASE_URL=https://car-apis.202corp.com/vehicle-service/client-api/v1

# ---- General ----
APP_NAME=Car Launcher
APP_ENV=production
LOG_LEVEL=warn
ENABLE_DEBUG_BANNER=false
